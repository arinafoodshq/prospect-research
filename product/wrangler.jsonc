// product/wrangler.jsonc â€” Worker + D1 + Workflow bindings skeleton.
// Account id: 5b1a6a62ef2a35ff1da503bafc123ef6. No secrets here; MODEL_API_KEY
// is set via `wrangler secret put MODEL_API_KEY` (dev: untracked .dev.vars).
// Static frontend serving mechanism is open item O-1 in specs/architecture.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prospect-research",
  "account_id": "5b1a6a62ef2a35ff1da503bafc123ef6",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Local dev (Windows): `wrangler dev` cannot run the SMTP relay container
  // here (no Docker); the container binding stays active on deploys. Remove
  // this block only on a machine with Docker available.
  "dev": { "enable_containers": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prospect_research",
      "database_id": "f403c035-dcfd-4dda-baf9-aead92233bd1"
    }
  ],
  // Staging environment (owner request 2026-11-05): a second worker with its
  // OWN D1 so live keeps serving the version people use while speed rework
  // is tested. Deploy: `wrangler deploy --env staging` -> its own
  // workers.dev URL. Promote: the plain `wrangler deploy`. The delivery
  // queue is shared with live for now — do NOT test sending on staging
  // until staging gets its own queue (Phase 2).
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "prospect_research_staging",
          "database_id": "88cc8954-a128-4a12-881f-133aa0fbe9b8"
        }
      ],
      // Wrangler does NOT inherit containers/queues into environments: bind
      // them explicitly (shared with live for now — no sends on staging).
      "containers": [{
        "class_name": "SmtpRelayContainer",
        "image": "./smtp-relay/Dockerfile",
        "max_instances": 1,
        "instance_type": "standard-1"
      }],
      "queues": {
        "producers": [{ "binding": "DELIVERY_QUEUE", "queue": "delivery-jobs-staging" }],
        "consumers": [{
          "queue": "delivery-jobs-staging",
          "max_batch_size": 10,
          "max_batch_timeout": 5,
          "max_retries": 5,
          "retry_delay": 60,
          "max_concurrency": 2,
          "dead_letter_queue": "delivery-dlq-staging"
        }]
      },
      "vars": {
        "MODEL_ID": "muse-spark-1.3",
        "ENVIRONMENT": "production",
        "PUBLIC_BASE_URL": "https://prospect-research-staging.sam-5b1.workers.dev"
      }
    }
  },
  "workflows": [
    {
      "name": "research-workflow",
      "binding": "RESEARCH_WORKFLOW",
      "class_name": "ResearchWorkflowEntrypoint"
    }
  ],
  // Static assets (O-1 resolved): Workers Static Assets serves ./public;
  // /api/* falls through to the Worker. No separate binding needed.
  // SPA fallback serves index.html for navigation to /demo (judges path).
  // run_worker_first: browser NAVIGATIONS to /api/* (auth links, unsubscribe
  // links) must reach the Worker, not the SPA fallback — without this the
  // assets layer served index.html for /api/auth/start and the app rendered
  // unstyled (bug found 2026-10-31 on the live auth page).
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // Workers Logs: console output (workflow logs, errors) visible in the
  // dashboard + `wrangler tail`; complements the D1 audit_log trail.
  "observability": { "enabled": true },
  // Campaign delivery tick: every 5 minutes (UTC). Changes take ~15 min to propagate.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Delivery pipeline: cron/process enqueue due recipients; the consumer sends.
  // Backpressure: batch 10 + max 2 concurrent consumers; crashes retry x5 then DLQ.
  "queues": {
    "producers": [{ "binding": "DELIVERY_QUEUE", "queue": "delivery-jobs" }],
    "consumers": [{
      "queue": "delivery-jobs",
      "max_batch_size": 10,
      "max_batch_timeout": 5,
      "max_retries": 5,
      "retry_delay": 60,
      "max_concurrency": 2,
      "dead_letter_queue": "delivery-dlq"
    }]
  },
  // SMTP relay container: binding-only, no public route; standard-1 for headroom
  // (relay is I/O-bound — bigger instances would not send faster).
  "containers": [{
    "class_name": "SmtpRelayContainer",
    "image": "./smtp-relay/Dockerfile",
    "max_instances": 2,
    "instance_type": "standard-1"
  }],
  "durable_objects": {
    "bindings": [{ "name": "SMTP_RELAY", "class_name": "SmtpRelayContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SmtpRelayContainer"] }],
  "vars": {
    "MODEL_ID": "muse-spark-1.3",
    "ENVIRONMENT": "production",
    "PUBLIC_BASE_URL": "https://prospect-research.sam-5b1.workers.dev"
  }
}
