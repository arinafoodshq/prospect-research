{
  "name": "prospect-research",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed prospect research: Worker API + D1 + Workflow + SPA shell.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute prospect_research --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute prospect_research --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20251017.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "wrangler": "^3.99.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
